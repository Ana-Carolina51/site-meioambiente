@bot.event
async def on_command_error(ctx, error):
    if isinstance(error, commands.CommandNotFound):
        await ctx.send("❌ Comando não encontrado. Use `$ajuda` para ver os comandos disponíveis.")
    elif isinstance(error, commands.MissingRequiredArgument):
        await ctx.send("❌ Argumento ausente. Verifique o comando e tente novamente.")
    elif isinstance(error, commands.BadArgument):
        await ctx.send("❌ Argumento inválido. Verifique o comando e tente novamente.")
    else:
        await ctx.send(f"❌ Ocorreu um erro: {str(error)}")


@bot.event
async def on_message(message):
    if message.author == bot.user:
        return

    # Verifica se a mensagem contém a palavra "bot"
    if "bot" in message.content.lower():
        await message.channel.send("Olá! Eu sou o bot do servidor. Use `$ajuda` para ver os comandos disponíveis.")

    await bot.process_commands(message)


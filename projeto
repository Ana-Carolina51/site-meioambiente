#limpar mensagens
@bot.command()
@commands.has_permissions(manage_messages=True)
async def clear(ctx, quantidade: int):
    if quantidade <= 0:
        await ctx.send("❌ Use um número maior que 0.")
        return

    # +1 para apagar a mensagem do comando também
    apagadas = await ctx.channel.purge(limit=quantidade + 1)

    msg = await ctx.send(f"🧹 {len(apagadas) - 1} mensagens apagadas com sucesso!")
    # Apaga a mensagem de confirmação depois de 5 segundos
    await msg.delete(delay=5)

@clear.error
async def clear_error(ctx, error):
    if isinstance(error, commands.MissingPermissions):
        await ctx.send("❌ Você não tem permissão para usar esse comando.")
    elif isinstance(error, commands.MissingRequiredArgument):
        await ctx.send("❌ Use: `$clear <quantidade>`")
    elif isinstance(error, commands.BadArgument):
        await ctx.send("❌ A quantidade precisa ser um número.")

#pokémon aleatório
def get_poke_image_url():
    poke_id = random.randint(1, 151)  # Pokémon da 1ª geração
    url = f'https://pokeapi.co/api/v2/pokemon/{poke_id}'

    res = requests.get(url)
    data = res.json()

    # pega a imagem do Pokémon
    image_url = data['sprites']['front_default']
    nome = data['name'].capitalize()

    return nome, image_url


@bot.command('poke')
async def poke(ctx):
    nome, image_url = get_poke_image_url()
    await ctx.send(f"⚡ Pokémon sorteado: **{nome}**")
    await ctx.send(image_url)

#jogo da forca
@bot.command()
async def forca(ctx):
    palavras = ["python", "discord", "programacao", "bot", "jogo"]
    palavra = random.choice(palavras)
    letras_descobertas = ["_"] * len(palavra)
    tentativas = 6

    await ctx.send(f"Jogo da forca iniciado! A palavra tem {len(palavra)} letras.\n"
                   f"{' '.join(letras_descobertas)}\n"
                   f"Você tem {tentativas} tentativas.")

    def check(m):
        return m.author == ctx.author and len(m.content) == 1 and m.content.isalpha()

    while tentativas > 0 and "_" in letras_descobertas:
        try:
            msg = await bot.wait_for('message', check=check, timeout=30.0)
            letra = msg.content.lower()

            if letra in palavra:
                for i, l in enumerate(palavra):
                    if l == letra:
                        letras_descobertas[i] = letra
                await ctx.send(f"✅ Letra correta!\n{' '.join(letras_descobertas)}")
            else:
                tentativas -= 1
                await ctx.send(f"❌ Letra incorreta! Tentativas restantes: {tentativas}")

        except asyncio.TimeoutError:
            await ctx.send("⏰ Tempo esgotado! O jogo terminou.")
            return

    if "_" not in letras_descobertas:
        await ctx.send(f"🎉 Parabéns! Você adivinhou a palavra: **{palavra}**")
    else:
        await ctx.send(f"💀 Você perdeu! A palavra era: **{palavra}**")



#memes sobre o meio ambiente
@bot.command()
async def meme(ctx):
    pasta = os.path.join(BASE_DIR, "memes")

    if not os.path.exists(pasta):
        await ctx.send(f"❌ Pasta não encontrada:\n{pasta}")
        return

    arquivos = [
        f for f in os.listdir(pasta)
        if os.path.isfile(os.path.join(pasta, f))
    ]

    if not arquivos:
        await ctx.send("❌ Não há memes na pasta.")
        return

    arquivo = random.choice(arquivos)
    caminho = os.path.join(pasta, arquivo)

    await ctx.send(file=discord.File(caminho))


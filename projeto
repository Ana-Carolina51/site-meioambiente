#jogo da forca
@bot.command()
async def forca(ctx):
    palavras = ["Aquecimento global", "Efeito estufa", "Crise climática", "Combustíveis fósseis", "Desmatamento"]
    palavra = random.choice(palavras)
    letras_descobertas = ["_"] * len(palavra)
    tentativas = 6

    await ctx.send(f"Jogo da forca iniciado! A palavra tem {len(palavra)} letras.\n"
                   f"{' '.join(letras_descobertas)}\n"
                   f"Você tem {tentativas} tentativas.")

    def check(m):
        return m.author == ctx.author and len(m.content) == 1 and m.content.isalpha()

    while tentativas > 0 and "_" in letras_descobertas:
        try:
            msg = await bot.wait_for('message', check=check, timeout=30.0)
            letra = msg.content.lower()

            if letra in palavra:
                for i, l in enumerate(palavra):
                    if l == letra:
                        letras_descobertas[i] = letra
                await ctx.send(f"✅ Letra correta!\n{' '.join(letras_descobertas)}")
            else:
                tentativas -= 1
                await ctx.send(f"❌ Letra incorreta! Tentativas restantes: {tentativas}")

        except asyncio.TimeoutError:
            await ctx.send("⏰ Tempo esgotado! O jogo terminou.")
            return

    if "_" not in letras_descobertas:
        await ctx.send(f"🎉 Parabéns! Você adivinhou a palavra: **{palavra}**")
    else:
        await ctx.send(f"💀 Você perdeu! A palavra era: **{palavra}**")


